# Copy to .env.release (gitignored) for `bin/release` / git-docker-release.
# Registry (GHCR)
# GHCR_TOKEN=
# GHCR_USERNAME=
# Or use GITHUB_TOKEN + GITHUB_ACTOR in CI-like environments.

# S3 asset upload (bin/build-and-upload-assets → assets:build_and_sync_to_s3)
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
